# P6-39 reference pipeline: two Cloud Run jobs and their daily Cloud Scheduler triggers, behind
# var.pipeline.enabled.
#
# - <business>-ingest runs in the core data project as <business>-ingest-<env>: load landed CSV
#   files into the raw or staging dataset, transform to staging and curated, and run the scans of
#   those tables. It holds bigquery.jobUser in the core data project (§2.4.2).
# - <business>-build runs in the analytics project as <business>-analytics-<env>: build the
#   product tables in the analytics dataset and run their scans. The analytics account is the
#   writer of analytics datasets and reads curated datasets (§2.4.3, §3.3), so it, and not the
#   ingest account, builds product tables (see README, "Contract differences").
#
# The synthetic-data generator is not part of these jobs: the ingest account has only
# storage.objectViewer on the landing bucket (§2.4.2), so files are generated by a developer or
# the Cloud Build pipeline (pipelines/cloudbuild.yaml) with landing-bucket write access.
#
# Platform asks (VERIFY IN BUILD (estate)): run.googleapis.com and cloudscheduler.googleapis.com
# enabled in the core and analytics projects; the apply account holds iam.serviceAccountUser on
# both runtime accounts; the Cloud Scheduler service agent can mint tokens for them.

locals {
  pipeline_config = yamldecode(replace(file("${local.root}/pipelines/config.yaml"), "{env}", var.env))
  consumes        = var.pipeline.enabled ? try(local.pipeline_config.consumes, {}) : {}

  scan_names = {
    for id, sc in local.scans : id => "projects/${sc.project}/locations/${var.region}/dataScans/${id}"
  }

  pipeline_jobs = var.pipeline.enabled ? {
    ingest = {
      project = local.core_project
      account = local.ingest_account
      stage   = "ingest"
      scans   = [for id, sc in local.scans : local.scan_names[id] if sc.stage != "analytics"]
      offset  = 0
    }
    build = {
      project = local.analytics_project
      account = local.analytics_account
      stage   = "build"
      scans   = [for id, sc in local.scans : local.scan_names[id] if sc.stage == "analytics"]
      offset  = 1
    }
  } : {}
}

# Products this domain's pipeline consumes from other domains, read from their published
# definitions in the hub state bucket (AT-23). A missing file fails the plan.
data "google_storage_bucket_object_content" "consumed_product" {
  for_each = local.consumes
  bucket   = local.hub_state_bucket
  name     = "products/${var.env}/${each.value.domain}/${each.value.product}.json"

  lifecycle {
    postcondition {
      condition     = trimspace(self.content == null ? "" : self.content) != ""
      error_message = "Consumed product ${each.value.domain}/${each.value.product} is not published yet."
    }
  }
}

locals {
  # Consumed asset tables as project.dataset.table, keyed as in pipelines/config.yaml.
  consumed_tables = {
    for k, c in local.consumes : k => join(".", [
      for i, part in split("/", trimprefix(jsondecode(data.google_storage_bucket_object_content.consumed_product[k].content).assets[c.asset].table_resource, "//bigquery.googleapis.com/")) : part if i % 2 == 1
    ])
  }
}

resource "google_cloud_run_v2_job" "pipeline" {
  for_each = local.pipeline_jobs

  project             = each.value.project
  location            = var.region
  name                = "${var.business}-${each.key}"
  deletion_protection = false
  labels              = local.labels_doc.jobs

  template {
    labels      = local.labels_doc.jobs
    task_count  = 1
    parallelism = 1

    template {
      service_account = each.value.account
      timeout         = "3600s"
      max_retries     = 1

      containers {
        image = var.pipeline.image
        args  = ["run", "--stage", each.value.stage]

        env {
          name  = "DDA_BUSINESS"
          value = var.business
        }
        env {
          name  = "DDA_ENV"
          value = var.env
        }
        env {
          name  = "DDA_REGION"
          value = var.region
        }
        env {
          name  = "DDA_JOB_PROJECT"
          value = each.value.project
        }
        env {
          name  = "DDA_CORE_PROJECT"
          value = local.core_project
        }
        env {
          name  = "DDA_ANALYTICS_PROJECT"
          value = local.analytics_project
        }
        env {
          name  = "DDA_LANDING_BUCKET"
          value = local.landing_bucket
        }
        env {
          name  = "DDA_SCANS"
          value = join(",", each.value.scans)
        }
        env {
          name  = "DDA_CONSUMED_TABLES"
          value = jsonencode(local.consumed_tables)
        }
        resources {
          limits = {
            cpu    = "1"
            memory = "1Gi"
          }
        }
      }
    }
  }
}

# The runtime account starts its own job from Cloud Scheduler.
resource "google_cloud_run_v2_job_iam_member" "scheduler_invoker" {
  for_each = local.pipeline_jobs

  project  = each.value.project
  location = var.region
  name     = google_cloud_run_v2_job.pipeline[each.key].name
  role     = "roles/run.invoker"
  member   = "serviceAccount:${each.value.account}"
}

resource "google_cloud_scheduler_job" "pipeline" {
  for_each = local.pipeline_jobs

  project     = each.value.project
  region      = var.region
  name        = "${var.business}-${each.key}-daily"
  description = "Daily run of the ${var.business} ${each.key} pipeline (P6-39)."
  # The build job runs one hour after the ingest job.
  schedule  = join(" ", concat([split(" ", var.pipeline.schedule)[0]], [tostring((tonumber(split(" ", var.pipeline.schedule)[1]) + each.value.offset) % 24)], slice(split(" ", var.pipeline.schedule), 2, 5)))
  time_zone = var.pipeline.timezone

  http_target {
    http_method = "POST"
    uri         = "https://run.googleapis.com/v2/projects/${each.value.project}/locations/${var.region}/jobs/${google_cloud_run_v2_job.pipeline[each.key].name}:run"

    oauth_token {
      service_account_email = each.value.account
      scope                 = "https://www.googleapis.com/auth/cloud-platform"
    }
  }

  depends_on = [google_cloud_run_v2_job_iam_member.scheduler_invoker]
}
